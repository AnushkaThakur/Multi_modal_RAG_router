# Copy this file to .env and fill provider keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
TOGETHERAI_API_KEY=
# Optional but recommended for faster HF downloads.
HF_TOKEN=

# Embedding model used for local vectorization.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Classifier model should be cheap and fast.
CLASSIFIER_MODEL=gpt-4o-mini

# Default domain preset if --domain is not passed.
ROUTER_DOMAIN=support

# Tier model lists are comma-separated in priority order.
# Use models you have access to in your account.
TIER_1_MODELS=gpt-4o-mini,groq/llama-3.1-8b-instant
TIER_2_MODELS=gpt-4o,claude-3-5-sonnet-latest
TIER_3_MODELS=o3-mini,gpt-4o

# Routing behavior.
CONFIDENCE_THRESHOLD=0.72
RETRIEVAL_TOP_K=4
CHUNK_SIZE=900
CHUNK_OVERLAP=120

# Semantic cache controls.
ENABLE_SEMANTIC_CACHE=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.9
SEMANTIC_CACHE_MAX_ENTRIES=1000
SEMANTIC_CACHE_MIN_CONFIDENCE=0.65
